SPREADSHEET_ID=your_new_campaign_sheet_id_here
GOOGLE_AUTH_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# Master admin credentials (Change these! ADMIN_USERNAME preferred; ADMIN_EMAIL also works)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Use a fresh secret - do NOT reuse the registration app's JWT_SECRET
JWT_SECRET=your-super-secret-jwt-key-change-in-production
